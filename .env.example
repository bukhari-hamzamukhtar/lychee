# Copy to .env.local and fill in your own values. Never commit the filled file.

# --- AMD Token Factory -------------------------------------------------------
# Free, OpenAI-compatible endpoints served on AMD GPUs. One key per team,
# redeemed at notebooks.amd.com/tokenfactory once every member has signed in.
# Limits are per key, not per person: 20 RPM and a rolling daily spend cap.
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=

# Generator. Gemma-4-31B-IT is Google's model and the one we would rather use,
# but on 14 Oct 2026 it collapses into repeated fragments and leaks raw special
# tokens on every call, short or long. Flip this back the moment AMD fixes the
# endpoint; nothing else needs to change.
AMD_MODEL_GENERATE=DeepSeek-V4-Flash
AMD_MODEL_FALLBACK=DeepSeek-V4-Flash
AMD_MODEL_OCR=MinerU2.5-Pro

# --- Evolus ------------------------------------------------------------------
# Event workspace, created from evolus.ai/en/hackathon. A workspace made any
# other way is not an event workspace. Capped at 60 requests per minute.
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# Optional: set to drive the hosted workflow instead of calling tools directly.
EVOLUS_WORKFLOW_ID=
