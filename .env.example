# Copy to .env.local and fill in your own values. Never commit the filled file.

# --- AMD Token Factory -------------------------------------------------------
# Free, OpenAI-compatible endpoints served on AMD GPUs. One key per team,
# redeemed at notebooks.amd.com/tokenfactory once every member has signed in.
# Limits are per key, not per person: 20 RPM and a rolling daily spend cap.
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=

# Generator. Gemma-4-31B-IT is Google's open model and the one the Google
# partner prize asks for. It was unusable on 14 Oct (repeated fragments, leaked
# special tokens) and withdrawn from the catalogue entirely on 15 Oct; AMD
# restored it on 16 Oct and it now passes every shape this pipeline needs —
# verify with `npx tsx scripts/probe-gemma-fitness.ts`.
#
# The fallback is not decoration. A model that has been pulled once can be
# pulled again, so a hard failure on the generator retries on this one.
AMD_MODEL_GENERATE=Gemma-4-31B-IT
AMD_MODEL_FALLBACK=DeepSeek-V4-Flash
AMD_MODEL_OCR=MinerU2.5-Pro

# Optional: serve generation from your own vLLM endpoint on an AMD Developer
# Cloud droplet, which is what the Evolus track asks for. Unset, generation uses
# AMD_BASE_URL above and nothing changes. OCR always stays on Token Factory
# because MinerU is only served there. See docs/EVOLUS-TRACK-VLLM.md.
# AMD_GENERATE_BASE_URL=http://<droplet-ip>:8000/v1
# AMD_GENERATE_API_KEY=
# AMD_MODEL_GENERATE=Qwen/Qwen2.5-7B-Instruct

# Optional: the ingest route runs on a clock, because maxDuration is 60s and
# the platform does not warn before it cuts. Lower these to exercise the branch
# that drops the optional extractor rather than overrun the limit.
# INGEST_BUDGET_MS=55000
# INGEST_MODEL_RESERVE_MS=22000

# --- Evolus ------------------------------------------------------------------
# Event workspace, created from evolus.ai/en/hackathon. A workspace made any
# other way is not an event workspace. Capped at 60 requests per minute.
EVOLUS_BASE_URL=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# Optional: set to drive the hosted workflow instead of calling tools directly.
EVOLUS_WORKFLOW_ID=

# Agent created in the event workspace, running on the connected AMD model.
EVOLUS_AGENT_ID=
